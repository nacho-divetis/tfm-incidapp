# Puerto HTTP
PORT=3000
# Entorno: development | production | test
NODE_ENV=development
# Secreto para firmar los JWT de sesión (OBLIGATORIO en producción, mínimo 32 caracteres)
JWT_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio-de-32+
# Base de datos:
#  - vacío  -> PostgreSQL embebido (PGlite) en ./data/pgdata (desarrollo, no requiere instalar nada)
#  - postgres://usuario:clave@host:5432/bd -> PostgreSQL real (producción)
DATABASE_URL=
# Carga datos de demostración al arrancar si la BD está vacía (true/false)
SEED_DEMO=true
